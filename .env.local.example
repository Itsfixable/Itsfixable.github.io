# Supabase project for the Query lab demo (Experience → Rox AI).
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The key is the public "anon" key (newer projects call it "publishable").
# It is safe in the browser: the demo_accounts table is read-only for it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
